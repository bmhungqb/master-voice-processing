  "chapter_idx": 4,
  "chapter_title": "Chương 4",
  "total_paragraphs": 63,
  "total_sentences": 195,
  "segments": [
    {
      "sent_id": "id_4",
      "smil_sid": "sid_4",
      "p_id": "c4_p1",
      "seq_id": "seq_1",
      "text": "Rồi đây, hai mẹ con em sẽ xoay xở thế nào với ba mươi phờrăng, trong khi dự chi đến một trăm phờrăng."
    },
    {
      "sent_id": "id_5",
      "smil_sid": "sid_5",
      "p_id": "c4_p2",
      "seq_id": "seq_2",
      "text": "Bà mẹ quyết định:"
    },
    {
      "sent_id": "id_6",
      "smil_sid": "sid_6",
      "p_id": "c4_p3",
      "seq_id": "seq_3",
      "text": "- Phải đi thôi!"
    },
    {
      "sent_id": "id_7",
      "smil_sid": "sid_7",
      "p_id": "c4_p3",
      "seq_id": "seq_3",
      "text": "Phải đi ngay tức khắc đến Marôcua."
    },
    {
      "sent_id": "id_8",
      "smil_sid": "sid_8",
      "p_id": "c4_p4",
      "seq_id": "seq_4",
      "text": "- Mẹ đã khỏe chưa?"
    },
    {
      "sent_id": "id_9",
      "smil_sid": "sid_9",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "- Mẹ phải cố gắng chứ!"
    },
    {
      "sent_id": "id_10",
      "smil_sid": "sid_10",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "Chúng ta đã chờ đợi quá lâu vì hy vọng mẹ sẽ bình phục: nhưng sự bình phục ấy sẽ không đến ở nơi này đâu!"
    },
    {
      "sent_id": "id_11",
      "smil_sid": "sid_11",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "Trong lúc ấy thì túi tiền của chúng ta đã cạn cũng như số tiền bán con Palica tội nghiệp rồi sẽ mòn dần."
    },
    {
      "sent_id": "id_12",
      "smil_sid": "sid_12",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "Mẹ cũng muốn chúng ta không đến đó trong tình trạng nghèo khổ này."
    },
    {
      "sent_id": "id_13",
      "smil_sid": "sid_13",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "Nhưng biết đâu cái nghèo khổ càng thảm hại càng làm cho người ta thương cảm."
    },
    {
      "sent_id": "id_14",
      "smil_sid": "sid_14",
      "p_id": "c4_p5",
      "seq_id": "seq_5",
      "text": "Cần phải đi thôi!"
    },
    {
      "sent_id": "id_15",
      "smil_sid": "sid_15",
      "p_id": "c4_p6",
      "seq_id": "seq_6",
      "text": "- Ngay hôm nay sao?"
    },
    {
      "sent_id": "id_16",
      "smil_sid": "sid_16",
      "p_id": "c4_p7",
      "seq_id": "seq_7",
      "text": "- Hôm nay thì muộn rồi!"
    },
    {
      "sent_id": "id_17",
      "smil_sid": "sid_17",
      "p_id": "c4_p7",
      "seq_id": "seq_7",
      "text": "Chúng ta sẽ đến đó trong đêm tối thì biết về đâu kia chứ?"
    },
    {
      "sent_id": "id_18",
      "smil_sid": "sid_18",
      "p_id": "c4_p7",
      "seq_id": "seq_7",
      "text": "Sáng mai vậy!"
    },
    {
      "sent_id": "id_19",
      "smil_sid": "sid_19",
      "p_id": "c4_p7",
      "seq_id": "seq_7",
      "text": "Chiều nay, con đi hỏi giờ tàu chạy tuyến đường sắt khu Bắc và giá vé đi đến ga Pichkynhi."
    },
    {
      "sent_id": "id_20",
      "smil_sid": "sid_20",
      "p_id": "c4_p8",
      "seq_id": "seq_8",
      "text": "Perin bối rối hỏi Hạt Muối."
    },
    {
      "sent_id": "id_21",
      "smil_sid": "sid_21",
      "p_id": "c4_p8",
      "seq_id": "seq_8",
      "text": "Ông ta bảo em phải tìm trong đống giấy chắc sẽ thấy bản hướng dẫn của đướng sắt."
    },
    {
      "sent_id": "id_22",
      "smil_sid": "sid_22",
      "p_id": "c4_p8",
      "seq_id": "seq_8",
      "text": "Theo giấy hướng dẫn, buổi sáng có hai chuyến: lúc sáu giờ và mười giờ."
    },
    {
      "sent_id": "id_23",
      "smil_sid": "sid_23",
      "p_id": "c4_p8",
      "seq_id": "seq_8",
      "text": "Giá vé hạng ba đến ga Pichkynhi là chín phờrăng hai lăm, một chỗ ngồi."
    },
    {
      "sent_id": "id_24",
      "smil_sid": "sid_24",
      "p_id": "c4_p9",
      "seq_id": "seq_9",
      "text": "- Chúng ta sẽ đi chuyến mười giờ, - Bà mẹ nói – Chúng ta thuê xe ngựa."
    },
    {
      "sent_id": "id_25",
      "smil_sid": "sid_25",
      "p_id": "c4_p9",
      "seq_id": "seq_9",
      "text": "Mẹ không thể đi bộ đến ga được vì quá xa!"
    },
    {
      "sent_id": "id_26",
      "smil_sid": "sid_26",
      "p_id": "c4_p9",
      "seq_id": "seq_9",
      "text": "Mẹ chỉ đủ sức đi đến bến xe ngựa."
    },
    {
      "sent_id": "id_27",
      "smil_sid": "sid_27",
      "p_id": "c4_p10",
      "seq_id": "seq_10",
      "text": "Thế nhưng bà không đi đến đó được!"
    },
    {
      "sent_id": "id_28",
      "smil_sid": "sid_28",
      "p_id": "c4_p11",
      "seq_id": "seq_11",
      "text": "Lúc chín giờ, bà muốn tựa vào con gái đi đón xe vì Perin đã đi gọi và xe sắp đến."
    },
    {
      "sent_id": "id_29",
      "smil_sid": "sid_29",
      "p_id": "c4_p11",
      "seq_id": "seq_11",
      "text": "Từ buồng mẹ con bà ra đường cái không phải là xa nhưng tim bà yếu quá!"
    },
    {
      "sent_id": "id_30",
      "smil_sid": "sid_30",
      "p_id": "c4_p11",
      "seq_id": "seq_11",
      "text": "Nếu Perin không đỡ kịp, thì bà đã ngã rồi!"
    },
    {
      "sent_id": "id_31",
      "smil_sid": "sid_31",
      "p_id": "c4_p12",
      "seq_id": "seq_12",
      "text": "- Rồi mẹ sẽ khỏi thôi!"
    },
    {
      "sent_id": "id_32",
      "smil_sid": "sid_32",
      "p_id": "c4_p12",
      "seq_id": "seq_12",
      "text": "– Bà nói thầm thì – Con đừng lo!"
    },
    {
      "sent_id": "id_33",
      "smil_sid": "sid_33",
      "p_id": "c4_p12",
      "seq_id": "seq_12",
      "text": "Rồi sẽ tốt thôi!"
    },
    {
      "sent_id": "id_34",
      "smil_sid": "sid_34",
      "p_id": "c4_p13",
      "seq_id": "seq_13",
      "text": "Tuy nhiên, thật chẳng tốt tí nào!"
    },
    {
      "sent_id": "id_35",
      "smil_sid": "sid_35",
      "p_id": "c4_p13",
      "seq_id": "seq_13",
      "text": "Bà Hầu tước trông thấy hai mẹ con ra đi như thế, đã mang đến một cái ghế."
    },
    {
      "sent_id": "id_36",
      "smil_sid": "sid_36",
      "p_id": "c4_p13",
      "seq_id": "seq_13",
      "text": "Một cố gắng tuyệt vọng đã nâng đỡ bà mẹ của Perin cho tới đây."
    },
    {
      "sent_id": "id_37",
      "smil_sid": "sid_37",
      "p_id": "c4_p13",
      "seq_id": "seq_13",
      "text": "Bởi thế, khi bà ngồi xuống ghế thì bị choáng!"
    },
    {
      "sent_id": "id_38",
      "smil_sid": "sid_38",
      "p_id": "c4_p13",
      "seq_id": "seq_13",
      "text": "Bà ngạt thở, không nói được nữa!"
    },
    {
      "sent_id": "id_39",
      "smil_sid": "sid_39",
      "p_id": "c4_p14",
      "seq_id": "seq_14",
      "text": "- Phải để mẹ cháu nằm dài, bà Hầu tước nói, phải xoa bóp cho mẹ cháu!"
    },
    {
      "sent_id": "id_40",
      "smil_sid": "sid_40",
      "p_id": "c4_p14",
      "seq_id": "seq_14",
      "text": "Không hề gì đâu, cháu đừng sợ!"
    },
    {
      "sent_id": "id_41",
      "smil_sid": "sid_41",
      "p_id": "c4_p14",
      "seq_id": "seq_14",
      "text": "Cháu đi gọi Bố Cá Chép."
    },
    {
      "sent_id": "id_42",
      "smil_sid": "sid_42",
      "p_id": "c4_p14",
      "seq_id": "seq_14",
      "text": "Có hai người, bác sẽ đưa mẹ cháu về buồng!"
    },
    {
      "sent_id": "id_43",
      "smil_sid": "sid_43",
      "p_id": "c4_p14",
      "seq_id": "seq_14",
      "text": "Mẹ con cháu không thể ra đi… ngay bây giờ được."
    },
    {
      "sent_id": "id_44",
      "smil_sid": "sid_44",
      "p_id": "c4_p15",
      "seq_id": "seq_15",
      "text": "Bà Hầu tước là một phụ nữ giàu kinh nghiệm."
    },
    {
      "sent_id": "id_45",
      "smil_sid": "sid_45",
      "p_id": "c4_p15",
      "seq_id": "seq_15",
      "text": "Khi người bệnh nằm dài, tim lại đập, hơi thở trở lại bình thường."
    },
    {
      "sent_id": "id_46",
      "smil_sid": "sid_46",
      "p_id": "c4_p15",
      "seq_id": "seq_15",
      "text": "Một lát sau, bà mẹ Perin muốn ngồi dậy, vì thế bà lại ngất."
    },
    {
      "sent_id": "id_47",
      "smil_sid": "sid_47",
      "p_id": "c4_p16",
      "seq_id": "seq_16",
      "text": "Bà thấy đó, bà phải nằm yên!"
    },
    {
      "sent_id": "id_48",
      "smil_sid": "sid_48",
      "p_id": "c4_p16",
      "seq_id": "seq_16",
      "text": "– Bà Hầu tước nói như ra lệnh."
    },
    {
      "sent_id": "id_49",
      "smil_sid": "sid_49",
      "p_id": "c4_p16",
      "seq_id": "seq_16",
      "text": "Ngày mai, bà sẽ lên đường!"
    },
    {
      "sent_id": "id_50",
      "smil_sid": "sid_50",
      "p_id": "c4_p16",
      "seq_id": "seq_16",
      "text": "Bây giờ, bà dùng một tách nước hầm."
    },
    {
      "sent_id": "id_51",
      "smil_sid": "sid_51",
      "p_id": "c4_p16",
      "seq_id": "seq_16",
      "text": "Tôi sẽ hỏi xin Bố Cá Chép cho bà."
    },
    {
      "sent_id": "id_52",
      "smil_sid": "sid_52",
      "p_id": "c4_p17",
      "seq_id": "seq_17",
      "text": "Không đợi trả lời, bà vào buồng ông láng giếng ngồi làm việc và nói:"
    },
    {
      "sent_id": "id_53",
      "smil_sid": "sid_53",
      "p_id": "c4_p18",
      "seq_id": "seq_18",
      "text": "- Ông cho tôi xin một tách nước hầm cho người bệnh!"
    },
    {
      "sent_id": "id_54",
      "smil_sid": "sid_54",
      "p_id": "c4_p19",
      "seq_id": "seq_19",
      "text": "Một nụ cười thay câu trả lời của Bố Cá Chép."
    },
    {
      "sent_id": "id_55",
      "smil_sid": "sid_55",
      "p_id": "c4_p19",
      "seq_id": "seq_19",
      "text": "Ngay tức khắc, ông ta mở vung cái nồi đất đang sôi trên bếp."
    },
    {
      "sent_id": "id_56",
      "smil_sid": "sid_56",
      "p_id": "c4_p19",
      "seq_id": "seq_19",
      "text": "Mùi thơm của nồi hầm tỏa ra trong gian buồng."
    },
    {
      "sent_id": "id_57",
      "smil_sid": "sid_57",
      "p_id": "c4_p20",
      "seq_id": "seq_20",
      "text": "Ông ta tự hào và sung sướng, trợ mắt, phồng mũi nhìn bà Hầu tước."
    },
    {
      "sent_id": "id_58",
      "smil_sid": "sid_58",
      "p_id": "c4_p21",
      "seq_id": "seq_21",
      "text": "- Ừ, mi hầm ngon quá!"
    },
    {
      "sent_id": "id_59",
      "smil_sid": "sid_59",
      "p_id": "c4_p21",
      "seq_id": "seq_21",
      "text": "Bà Hầu tước nói."
    },
    {
      "sent_id": "id_60",
      "smil_sid": "sid_60",
      "p_id": "c4_p21",
      "seq_id": "seq_21",
      "text": "Nếu bát nước hầm này cứu được người phụ nữ khốn khổ thì bà ta sẽ được cứu sống!"
    },
    {
      "sent_id": "id_61",
      "smil_sid": "sid_61",
      "p_id": "c4_p21",
      "seq_id": "seq_21",
      "text": "Nhưng bà Hầu tước hạ thấp giọng, ông biết đấy, bà ấy mệt nặng, chắc không thể sống được!"
    },
    {
      "sent_id": "id_62",
      "smil_sid": "sid_62",
      "p_id": "c4_p22",
      "seq_id": "seq_22",
      "text": "Bố Cá Chép đưa tay ra."
    },
    {
      "sent_id": "id_63",
      "smil_sid": "sid_63",
      "p_id": "c4_p22",
      "seq_id": "seq_22",
      "text": "Với động tác ấy, ông muốn nói: “Chúng ta còn biết làm thế nào được chứ?”."
    },
    {
      "sent_id": "id_64",
      "smil_sid": "sid_64",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Họ làm gì ư?"
    },
    {
      "sent_id": "id_65",
      "smil_sid": "sid_65",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Thì mỗi người một cách, họ cũng đã làm nhưng tai họa là một việc thường xảy ra với những người nghèo khổ, làm cho họ không còn thấy ngạc nhiên và cũng không phản ứng nữa!"
    },
    {
      "sent_id": "id_66",
      "smil_sid": "sid_66",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Ở trên đời này, ai trách được tai họa kia chứ?"
    },
    {
      "sent_id": "id_67",
      "smil_sid": "sid_67",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Bạn hôm nay, tôi ngày mai, thế thôi!"
    },
    {
      "sent_id": "id_68",
      "smil_sid": "sid_68",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Bố Cá Chép đã múc bát nước hầm cho bà Hầu tước."
    },
    {
      "sent_id": "id_69",
      "smil_sid": "sid_69",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Bà cẩn thận mang về, không để rơi vãi một giọt."
    },
    {
      "sent_id": "id_70",
      "smil_sid": "sid_70",
      "p_id": "c4_p23",
      "seq_id": "seq_23",
      "text": "Bà quỳ gần bên nệm, nói với người bệnh."
    },
    {
      "sent_id": "id_71",
      "smil_sid": "sid_71",
      "p_id": "c4_p24",
      "seq_id": "seq_24",
      "text": "- Bà húp một miếng!"
    },
    {
      "sent_id": "id_72",
      "smil_sid": "sid_72",
      "p_id": "c4_p24",
      "seq_id": "seq_24",
      "text": "Đừng cử động, hãy há miệng!"
    },
    {
      "sent_id": "id_73",
      "smil_sid": "sid_73",
      "p_id": "c4_p25",
      "seq_id": "seq_25",
      "text": "Rất cẩn thận bà đổ một thìa nước hầm vào trong miệng người bệnh."
    },
    {
      "sent_id": "id_74",
      "smil_sid": "sid_74",
      "p_id": "c4_p25",
      "seq_id": "seq_25",
      "text": "Người bệnh không nuốt được, lại nôn ra và một cơn choáng kéo dài hơn lần trước, lại đến!"
    },
    {
      "sent_id": "id_75",
      "smil_sid": "sid_75",
      "p_id": "c4_p26",
      "seq_id": "seq_26",
      "text": "Đúng thế, nước hầm không hợp với người bệnh!"
    },
    {
      "sent_id": "id_76",
      "smil_sid": "sid_76",
      "p_id": "c4_p26",
      "seq_id": "seq_26",
      "text": "Bà Hầu tước nhận thấy vậy."
    },
    {
      "sent_id": "id_77",
      "smil_sid": "sid_77",
      "p_id": "c4_p26",
      "seq_id": "seq_26",
      "text": "Để khỏi lãng phí, bà bắt Perin uống bát nước hầm."
    },
    {
      "sent_id": "id_78",
      "smil_sid": "sid_78",
      "p_id": "c4_p27",
      "seq_id": "seq_27",
      "text": "- Cháu cần phải có sức!"
    },
