  "chapter_idx": 1,
  "chapter_title": "Phần I: Mất Mẹ - Chương 1",
  "total_paragraphs": 118,
  "total_sentences": 247,
  "segments": [
    {
      "sent_id": "id_4",
      "smil_sid": "sid_4",
      "p_id": "c1_p1",
      "seq_id": "seq_1",
      "text": "Những ngày thứ bảy, vào khoảng ba giờ chiều mấy vùng kế cận cửa ô Bécxi thường bị tắc nghẽn."
    },
    {
      "sent_id": "id_5",
      "smil_sid": "sid_5",
      "p_id": "c1_p1",
      "seq_id": "seq_1",
      "text": "Trên lề đường, dưới ánh trăng tháng sáu đẹp trời, xe cộ xếp hàng tự nối đuôi nhau: xe bò chất đầy thùng phuy, xe ngắn chở than và vật liệu, xe nhỏ chở cỏ khô."
    },
    {
      "sent_id": "id_6",
      "smil_sid": "sid_6",
      "p_id": "c1_p1",
      "seq_id": "seq_1",
      "text": "Những chiếc xe ấy đợi sở Thuế khám xét và nôn nóng được vào Pari trong đêm, trước ngày chủ nhật."
    },
    {
      "sent_id": "id_7",
      "smil_sid": "sid_7",
      "p_id": "c1_p2",
      "seq_id": "seq_2",
      "text": "Về phía khá xa cửa chắn, giữa các cỗ xe có một chiếc hình dáng dị kỳ, vừa thảm hại lại vừa buồn cười."
    },
    {
      "sent_id": "id_8",
      "smil_sid": "sid_8",
      "p_id": "c1_p2",
      "seq_id": "seq_2",
      "text": "Cái cỗ xe ấy có vẻ như là xe lưu động ở các chợ phiên nhưng còn đơn giản hơn nhiều!"
    },
    {
      "sent_id": "id_9",
      "smil_sid": "sid_9",
      "p_id": "c1_p2",
      "seq_id": "seq_2",
      "text": "Nó chỉ là một cái sườn nhẹ, căng một tấm vải thô với cái mái bằng bìa cứng, quệt hắc ín."
    },
    {
      "sent_id": "id_10",
      "smil_sid": "sid_10",
      "p_id": "c1_p2",
      "seq_id": "seq_2",
      "text": "Cỗ xe nằm trên bốn bánh thấp trệt."
    },
    {
      "sent_id": "id_11",
      "smil_sid": "sid_11",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Có lẽ trước kia, tấm vải ấy màu da trời."
    },
    {
      "sent_id": "id_12",
      "smil_sid": "sid_12",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Bây giờ nó bạc phếch và bẩn thỉu, nên người ta chỉ còn biết phỏng đoán màu sắc của nó!"
    },
    {
      "sent_id": "id_13",
      "smil_sid": "sid_13",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Cũng như người ta đành phải ước đoán, nếu như muốn biết những dòng chữ đã mờ nhạt, che kín bốn thành xe."
    },
    {
      "sent_id": "id_14",
      "smil_sid": "sid_14",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Có mặt chỉ còn mấy chữ đầu, nhưng người ta vẫn đoán là chữ Hy Lạp."
    },
    {
      "sent_id": "id_15",
      "smil_sid": "sid_15",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Liền bên dưới là chữ Đức."
    },
    {
      "sent_id": "id_16",
      "smil_sid": "sid_16",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Và cuối cùng, còn tươi nét mực là chữ Pháp: Chụp ảnh."
    },
    {
      "sent_id": "id_17",
      "smil_sid": "sid_17",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Có lẽ đó là nội dung những dòng chữ trên."
    },
    {
      "sent_id": "id_18",
      "smil_sid": "sid_18",
      "p_id": "c1_p3",
      "seq_id": "seq_3",
      "text": "Như một tờ giấy đi đường, những xứ sở mà chiếc xe khốn khổ đã lăn qua, trước khi vào nước Pháp, và đến cửa ô Paris, đã được ghi rõ trên đó."
    },
    {
      "sent_id": "id_19",
      "smil_sid": "sid_19",
      "p_id": "c1_p4",
      "seq_id": "seq_4",
      "text": "Con lừa thắng vào cỗ xe ấy, có thể nào đến đây, từ những nơi xa xôi như vậy nhỉ?"
    },
    {
      "sent_id": "id_20",
      "smil_sid": "sid_20",
      "p_id": "c1_p5",
      "seq_id": "seq_5",
      "text": "Thoạt nhìn qua, người ta không tin vì nó quá gầy, chỉ còn da bọc xương, và kiệt sức."
    },
    {
      "sent_id": "id_21",
      "smil_sid": "sid_21",
      "p_id": "c1_p5",
      "seq_id": "seq_5",
      "text": "Khi nhìn kỹ, người ta nghĩ tình trạng kiệt quệ ấy chỉ là kết quả của những nỗi mệt nhọc kéo dài trong đói khổ."
    },
    {
      "sent_id": "id_22",
      "smil_sid": "sid_22",
      "p_id": "c1_p5",
      "seq_id": "seq_5",
      "text": "Con lừa ấy ăn không đủ no, mà lại phải đi quá xa!"
    },
    {
      "sent_id": "id_23",
      "smil_sid": "sid_23",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Thật ra, trước kia con vật ấy khỏe, khá to con, thon thả, cao hơn giống lừa châu Âu."
    },
    {
      "sent_id": "id_24",
      "smil_sid": "sid_24",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Nó có bộ lông màu xám tro với cái bụng màu sáng hơn, mặc dù bám đầy bụi đường."
    },
    {
      "sent_id": "id_25",
      "smil_sid": "sid_25",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Nhiều vệt đen kẻ ngang, dọc, in dấu trên mấy cái đùi thon thả, với những bàn chân có sọc."
    },
    {
      "sent_id": "id_26",
      "smil_sid": "sid_26",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Dẫu mệt mỏi, nó vẫn gan góc, và kiêu hãnh, ngẩng cao đầu."
    },
    {
      "sent_id": "id_27",
      "smil_sid": "sid_27",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Bộ yên của nó, cũng tồi tàn như cỗ xe, chắp nối bằng mấy sợi dây to, nhỏ, đủ màu sắc, nhặt được tình cờ."
    },
    {
      "sent_id": "id_28",
      "smil_sid": "sid_28",
      "p_id": "c1_p6",
      "seq_id": "seq_6",
      "text": "Để che nắng và chắn ruồi cho lừa, trên đường đi, người ta chặt những cành đơm hoa, những cây lau sậy, phủ lên lưng nó, che luôn cả bộ yên."
    },
    {
      "sent_id": "id_29",
      "smil_sid": "sid_29",
      "p_id": "c1_p7",
      "seq_id": "seq_7",
      "text": "Một em bé mười một, mười hai tuổi, ngồi trên lề đường, trông chừng nó."
    },
    {
      "sent_id": "id_30",
      "smil_sid": "sid_30",
      "p_id": "c1_p8",
      "seq_id": "seq_8",
      "text": "Em gái ấy là một mẫu người kỳ lạ!"
    },
    {
      "sent_id": "id_31",
      "smil_sid": "sid_31",
      "p_id": "c1_p8",
      "seq_id": "seq_8",
      "text": "Có nét thiếu hài hòa nhưng không có gì là thô bạo trong mẫu người lai giống này."
    },
    {
      "sent_id": "id_32",
      "smil_sid": "sid_32",
      "p_id": "c1_p8",
      "seq_id": "seq_8",
      "text": "Mái tóc nhạt và màu da hổ phách thật khá bất ngờ."
    },
    {
      "sent_id": "id_33",
      "smil_sid": "sid_33",
      "p_id": "c1_p8",
      "seq_id": "seq_8",
      "text": "Ngược lại, khuôn mặt có dáng nhẹ nhõm, dịu dàng nổi bật vì đôi mắt dài, đen, láu lỉnh và nghiêm trang."
    },
    {
      "sent_id": "id_34",
      "smil_sid": "sid_34",
      "p_id": "c1_p8",
      "seq_id": "seq_8",
      "text": "Cái miệng cũng vậy, trông thật đoan trang, nghiêm chỉnh."
    },
    {
      "sent_id": "id_35",
      "smil_sid": "sid_35",
      "p_id": "c1_p9",
      "seq_id": "seq_9",
      "text": "Trong lúc nghỉ ngơi, thân thể em được thoải mái, phơi bày những đường nét vừa dịu dàng và cứng cáp như ở trên khuôn mặt."
    },
    {
      "sent_id": "id_36",
      "smil_sid": "sid_36",
      "p_id": "c1_p9",
      "seq_id": "seq_9",
      "text": "Đôi vai mềm mại đỏ xuôi trong chiếc vét độn vai cũ kỹ, trước kia có lẽ là màu đen, bây giờ không biết là màu gì."
    },
    {
      "sent_id": "id_37",
      "smil_sid": "sid_37",
      "p_id": "c1_p9",
      "seq_id": "seq_9",
      "text": "Một chiếc váy rộng tồi tàn, có nhiều miếng vá, che cặp đùi chắc khỏe."
    },
    {
      "sent_id": "id_38",
      "smil_sid": "sid_38",
      "p_id": "c1_p9",
      "seq_id": "seq_9",
      "text": "Bộ cánh nghèo nàn ấy không làm giảm bớt chút nào cái vẻ tự hào của em bé."
    },
    {
      "sent_id": "id_39",
      "smil_sid": "sid_39",
      "p_id": "c1_p10",
      "seq_id": "seq_10",
      "text": "Trông giữ con lừa cũng chẳng khó khăn gì."
    },
    {
      "sent_id": "id_40",
      "smil_sid": "sid_40",
      "p_id": "c1_p10",
      "seq_id": "seq_10",
      "text": "Nhưng vì con vật đang đứng sau một chiếc xe lớn đang chở cỏ khô, nên thỉnh thoảng nó gặm chơi một miếng cỏ to, rất cẩn thận và kín đáo."
    },
    {
      "sent_id": "id_41",
      "smil_sid": "sid_41",
      "p_id": "c1_p10",
      "seq_id": "seq_10",
      "text": "Là một con vật rất thông minh, nó hiểu nó đang phạm lỗi."
    },
    {
      "sent_id": "id_42",
      "smil_sid": "sid_42",
      "p_id": "c1_p11",
      "seq_id": "seq_11",
      "text": "- Thôi chứ, Palica!"
    },
    {
      "sent_id": "id_43",
      "smil_sid": "sid_43",
      "p_id": "c1_p12",
      "seq_id": "seq_12",
      "text": "Tức thì con vật cuối đầu, như một người có lỗi, đang ăn năn."
    },
    {
      "sent_id": "id_44",
      "smil_sid": "sid_44",
      "p_id": "c1_p12",
      "seq_id": "seq_12",
      "text": "Những khi nó vừa nheo mắt, vẫy tai, ăn xong túm cỏ khô, thì nó lại vội vàng gặm một miếng nữa, vì nó đói quá!"
    },
    {
      "sent_id": "id_45",
      "smil_sid": "sid_45",
      "p_id": "c1_p13",
      "seq_id": "seq_13",
      "text": "Em bé vừa rầy nó, hình như lần thứ tư, thứ năm gì đó, thì trong xe có tiếng gọi:"
    },
    {
      "sent_id": "id_46",
      "smil_sid": "sid_46",
      "p_id": "c1_p14",
      "seq_id": "seq_14",
      "text": "- Perin!"
    },
    {
      "sent_id": "id_47",
      "smil_sid": "sid_47",
      "p_id": "c1_p15",
      "seq_id": "seq_15",
      "text": "Em vội vàng đứng lên, vén tấm màn, bước vào trong xe."
    },
    {
      "sent_id": "id_48",
      "smil_sid": "sid_48",
      "p_id": "c1_p15",
      "seq_id": "seq_15",
      "text": "Ở đây, một phụ nữ đang nằm trên tấm nệm mỏng như dính chặt với tấm ván."
    },
    {
      "sent_id": "id_49",
      "smil_sid": "sid_49",
      "p_id": "c1_p16",
      "seq_id": "seq_16",
      "text": "- Mẹ gọi con?"
    },
    {
      "sent_id": "id_50",
      "smil_sid": "sid_50",
      "p_id": "c1_p17",
      "seq_id": "seq_17",
      "text": "- Palica làm gì vậy?"
    },
    {
      "sent_id": "id_51",
      "smil_sid": "sid_51",
      "p_id": "c1_p18",
      "seq_id": "seq_18",
      "text": "- Nó ăn cỏ khô, chứa trong chiếc xe đứng trước xe chúng ta."
    },
    {
      "sent_id": "id_52",
      "smil_sid": "sid_52",
      "p_id": "c1_p19",
      "seq_id": "seq_19",
      "text": "- Phải ngăn nó!"
    },
    {
      "sent_id": "id_53",
      "smil_sid": "sid_53",
      "p_id": "c1_p20",
      "seq_id": "seq_20",
      "text": "- Nó đói!"
    },
    {
      "sent_id": "id_54",
      "smil_sid": "sid_54",
      "p_id": "c1_p21",
      "seq_id": "seq_21",
      "text": "- Đói cũng không được phép lấy của người khác!"
    },
    {
      "sent_id": "id_55",
      "smil_sid": "sid_55",
      "p_id": "c1_p21",
      "seq_id": "seq_21",
      "text": "Con sẽ trả lời thế nào với bác chủ xe, nếu bác nổi giận?"
    },
    {
      "sent_id": "id_56",
      "smil_sid": "sid_56",
      "p_id": "c1_p22",
      "seq_id": "seq_22",
      "text": "- Con sẽ kèm bên cạnh nó!"
    },
    {
      "sent_id": "id_57",
      "smil_sid": "sid_57",
      "p_id": "c1_p23",
      "seq_id": "seq_23",
      "text": "- Lát nữa, chúng ta có vào Paris được?"
    },
    {
      "sent_id": "id_58",
      "smil_sid": "sid_58",
      "p_id": "c1_p24",
      "seq_id": "seq_24",
      "text": "- Phải đợi sở Thuế kiểm tra, mẹ ạ!"
    },
    {
      "sent_id": "id_59",
      "smil_sid": "sid_59",
      "p_id": "c1_p25",
      "seq_id": "seq_25",
      "text": "- Có phải đợi lâu lắm không?"
    },
    {
      "sent_id": "id_60",
      "smil_sid": "sid_60",
      "p_id": "c1_p26",
      "seq_id": "seq_26",
      "text": "- Mẹ thấy mệt hơn trước ư?"
    },
    {
      "sent_id": "id_61",
      "smil_sid": "sid_61",
      "p_id": "c1_p27",
      "seq_id": "seq_27",
      "text": "- Con đừng lo, không có việc gì đâu!"
    },
    {
      "sent_id": "id_62",
      "smil_sid": "sid_62",
      "p_id": "c1_p28",
      "seq_id": "seq_28",
      "text": "Mẹ ngạt thở vì ẩm ướt! bà mẹ hổn hển, rít lên chứ không phát âm nổi!"
    },
    {
      "sent_id": "id_63",
      "smil_sid": "sid_63",
      "p_id": "c1_p29",
      "seq_id": "seq_29",
      "text": "Đó là những lời của một bà mẹ muốn làm yên lòng con gái."
    },
    {
      "sent_id": "id_64",
      "smil_sid": "sid_64",
      "p_id": "c1_p29",
      "seq_id": "seq_29",
      "text": "Sự thật là bà đang ở trong tình trạng đáng thương: thở khó khăn, kệt sức, không còn chút sinh lực nào!"
    },
    {
      "sent_id": "id_65",
      "smil_sid": "sid_65",
      "p_id": "c1_p30",
      "seq_id": "seq_30",
      "text": "Chưa quá hai sáu, hai bảy tuổi, bà đã suy nhược quá mức!"
    },
    {
      "sent_id": "id_66",
      "smil_sid": "sid_66",
      "p_id": "c1_p30",
      "seq_id": "seq_30",
      "text": "Bà còn giữ lại những đường nét của một vẻ đẹp đoan trang với khuôn mặt trái xoan, đôi mắt dịu dàng thắm thiết, giống hệt đôi mắt cô con gái, nhưng sáng hơn vì đang sốt."
    },
    {
      "sent_id": "id_67",
      "smil_sid": "sid_67",
      "p_id": "c1_p31",
      "seq_id": "seq_31",
      "text": "- Con kiếm cái gì cho mẹ nhé!"
    },
    {
      "sent_id": "id_68",
      "smil_sid": "sid_68",
      "p_id": "c1_p31",
      "seq_id": "seq_31",
      "text": "Perin hỏi."
    },
    {
      "sent_id": "id_69",
      "smil_sid": "sid_69",
      "p_id": "c1_p32",
      "seq_id": "seq_32",
      "text": "- Cái gì?"
    },
    {
      "sent_id": "id_70",
      "smil_sid": "sid_70",
      "p_id": "c1_p33",
      "seq_id": "seq_33",
      "text": "- Con mua cho mẹ quả chanh?"
    },
    {
      "sent_id": "id_71",
      "smil_sid": "sid_71",
